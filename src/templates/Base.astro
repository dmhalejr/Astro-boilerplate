---
import { ViewTransitions } from 'astro:transitions';

import { Footer } from '@/partials/Footer';
import { Navbar } from '@/partials/Navbar';
import { AppConfig } from '@/utils/AppConfig';

export interface Props {
  head: {
    title: string;
    description: string;
  };
}

const {
  head: { title, description },
} = Astro.props as Props;

// Absolute URLs for link previews and search engines.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/images/profile_pic.jpeg', Astro.site).href;
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='author' content={AppConfig.author} />
    <link rel='canonical' href={canonical} />

    <meta property='og:type' content='website' />
    <meta property='og:site_name' content={AppConfig.site_name} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={canonical} />
    <meta property='og:image' content={image} />
    <meta name='twitter:card' content='summary' />
    <meta name='theme-color' content='#0b1220' />

    <link rel='alternate' type='application/rss+xml' href='/rss.xml' />
    <link rel='icon' type='image/png' href='/favicon.png' />
    <slot name='head' />
    <ViewTransitions />
  </head>
  <body class='bg-storm-950 text-ink antialiased print:bg-white print:text-black'>
    <a
      href='#main'
      class='sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-bolt focus:px-4 focus:py-2 focus:text-storm-950'
    >
      Skip to content
    </a>

    <Navbar />

    <main id='main'>
      <slot />
    </main>

    <Footer />
  </body>
</html>

<script>
  // Fade content in as it scrolls into view. Runs after every page navigation.
  document.addEventListener('astro:page-load', () => {
    const items = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    items.forEach((item) => observer.observe(item));
  });
</script>

<style is:global>
  :focus-visible {
    outline: 2px solid #ffd84a;
    outline-offset: 2px;
  }

  ::selection {
    background: #ffd84a;
    color: #0b1220;
  }

  /* Entrance: rise and fade, staggered with --d. */
  .rise {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms) both;
  }

  /* A lightning flicker that follows the entrance. */
  .strike {
    animation:
      rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms) both,
      strike 0.9s linear 1.2s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes strike {
    0%,
    18%,
    36%,
    100% {
      filter: none;
      text-shadow: none;
    }
    9%,
    27% {
      filter: brightness(1.6);
      text-shadow: 0 0 32px rgb(255 216 74 / 70%);
    }
  }

  /* Rotating lightning ring around the portrait. */
  .photo-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: conic-gradient(
      #ffd84a,
      transparent 35%,
      #ffd84a 55%,
      transparent 85%,
      #ffd84a
    );
    animation: ring-spin 8s linear infinite;
  }

  @keyframes ring-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Scroll reveal. Only hides content when scripting can show it again. */
  @media (scripting: enabled) {
    [data-reveal] {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.6s ease-out,
        transform 0.6s ease-out;
    }

    [data-reveal].in {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }

    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
