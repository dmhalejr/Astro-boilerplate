---
import type {
  FrontmatterPage,
  IFrontmatter,
} from 'astro-boilerplate-components';

import { PostList } from '@/partials/PostList';
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { sortByDate } from '@/utils/Posts';

type GetStaticPaths = {
  paginate: any;
}; // Overrides `GetStaticPathsOptions` types from Astro

export async function getStaticPaths({ paginate }: GetStaticPaths) {
  const allPosts = await Astro.glob<IFrontmatter>('./*.md');
  const sortedPosts = sortByDate(allPosts);

  // Return a paginated collection of paths for all posts
  return paginate(sortedPosts, { pageSize: 6 });
}

interface Props {
  page: FrontmatterPage;
}

const { page } = Astro.props as Props;
const title = `Blog page ${page.currentPage} - ${AppConfig.site_name}`;
const description = 'Posts on software engineering by David Hale.';
const pagerClass =
  'text-sm font-medium text-mist transition-colors hover:text-bolt';
---

<Base head={{ title, description }}>
  <section class='mx-auto max-w-5xl px-4 pt-12 sm:px-6 sm:pt-16'>
    <h1 class='text-5xl font-black tracking-tighter sm:text-6xl'>Blog</h1>
    <p class='mb-10 mt-4 max-w-xl text-lg text-mist'>
      Notes on testing, tooling, and building software.
    </p>

    <PostList postList={page.data} headingLevel='h2' />

    {
      (page.url.prev || page.url.next) && (
        <nav aria-label='Pagination' class='mt-8 flex justify-between'>
          {page.url.prev ? (
            <a href={page.url.prev} class={pagerClass}>
              <span aria-hidden='true'>←</span> Newer posts
            </a>
          ) : (
            <span />
          )}
          {page.url.next && (
            <a href={page.url.next} class={pagerClass}>
              Older posts <span aria-hidden='true'>→</span>
            </a>
          )}
        </nav>
      )
    }
  </section>
</Base>
