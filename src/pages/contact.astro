---
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';

const { title, description } = AppConfig;
---

<Base head={{ title: `Contact - ${title}`, description }}>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        Get in Touch
      </h1>
      <p class="mt-4 text-lg leading-8 text-mist">
        I'd love to hear from you! Whether you have a question about my work, want to collaborate, or just want to say hello, feel free to reach out.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-2xl rounded-lg border border-storm-800 bg-storm-900 p-8">
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <h2 class="text-2xl font-bold text-ink">Contact Information</h2>
          <dl class="mt-6 space-y-4">
            <div>
              <dt class="text-sm font-medium text-mist">Social</dt>
              <dd class="mt-1">
                <div class="flex space-x-4">
                  <a
                    href="https://linkedin.com/in/dmhalejr"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-mist hover:text-bolt"
                  >
                    LinkedIn
                  </a>
                  <a
                    href="https://github.com/dmhalejr"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-mist hover:text-bolt"
                  >
                    GitHub
                  </a>
                </div>
              </dd>
            </div>
          </dl>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-ink">Send a Message</h2>
          <form id="contact-form" class="mt-6 space-y-4" method="POST" action="/api/contact">
            <div>
              <label for="name" class="block text-sm font-medium text-mist">
                Name
              </label>
              <input
                type="text"
                name="name"
                id="name"
                class="mt-1 block w-full rounded-md border border-storm-700 bg-storm-950 px-3 py-2 text-ink shadow-sm focus:border-bolt focus:outline-none focus:ring-1 focus:ring-bolt"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-mist">
                Email
              </label>
              <input
                type="email"
                name="email"
                id="email"
                class="mt-1 block w-full rounded-md border border-storm-700 bg-storm-950 px-3 py-2 text-ink shadow-sm focus:border-bolt focus:outline-none focus:ring-1 focus:ring-bolt"
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-mist">
                Message
              </label>
              <textarea
                name="message"
                id="message"
                rows={4}
                class="mt-1 block w-full rounded-md border border-storm-700 bg-storm-950 px-3 py-2 text-ink shadow-sm focus:border-bolt focus:outline-none focus:ring-1 focus:ring-bolt"
              />
            </div>
            <div>
              <button
                type="submit"
                class="w-full rounded-md bg-bolt px-4 py-2 font-semibold text-storm-950 hover:bg-ink focus:outline-none focus:ring-2 focus:ring-bolt focus:ring-offset-2 focus:ring-offset-storm-950"
              >
                Send Message
              </button>
            </div>
          </form>
          <div id="form-success" class="mt-4 hidden text-green-400 font-semibold">Thank you! Your message has been sent.</div>
          <script type="module">
            const form = document.getElementById('contact-form');
            const successMsg = document.getElementById('form-success');
            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              const formData = new FormData(form);
              const response = await fetch('/api/contact', {
                method: 'POST',
                body: formData
              });
              if (response.ok) {
                form.reset();
                successMsg.classList.remove('hidden');
              }
            });
          </script>
        </div>
      </div>
    </div>
  </div>
</Base> 