---
import { ProjectList } from '@/partials/ProjectList';
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';

const title = `Work - ${AppConfig.site_name}`;
const description = 'AI agent systems and open source tools by David Hale.';
---

<Base head={{ title, description }}>
  <section class='mx-auto max-w-5xl px-4 pt-12 sm:px-6 sm:pt-16'>
    <h1 class='text-5xl font-black tracking-tighter sm:text-6xl'>Work</h1>
    <p class='mb-10 mt-4 max-w-xl text-lg text-mist'>
      AI agent systems and open source tools I’ve built and maintain.
    </p>
    <ProjectList headingLevel='h2' />
  </section>
</Base>
